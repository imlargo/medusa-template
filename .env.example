# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required;
# everything else has a working default. The app validates all of this at
# startup and reports every problem at once.

# development | staging | production
# production enables Gin release mode, turns the docs OFF and requires a
# JWT_SECRET of at least 32 characters.
APP_ENV=development

# --- Server ---------------------------------------------------------------
# Inside a container this MUST be 0.0.0.0; localhost means "reachable from
# nothing". The Dockerfile already sets it.
HOST=localhost
PORT=8000

# Total budget for a graceful shutdown, split between draining SSE streams and
# draining HTTP requests. Keep it under your orchestrator's grace period:
# `docker stop` kills at 10s, Kubernetes at 30s.
SHUTDOWN_TIMEOUT=10s

# Largest accepted request body, in bytes (1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# Serve Swagger UI at /docs. Defaults to on outside production.
DOCS_ENABLED=true

# --- Database (required) --------------------------------------------------
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa?sslmode=disable

# --- Redis (optional; empty disables the cache) ---------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (JWT_SECRET required) -------------------------------------------
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=medusa
JWT_TOKEN_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# --- CORS -----------------------------------------------------------------
# Comma separated. The server's own host is always allowed.
CORS_ALLOWED_ORIGINS=

# --- Rate limiting (applies to all of /v1, public endpoints included) -----
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS_PER_TIME_FRAME=100
RATE_LIMITER_TIME_FRAME=1m

# --- Object storage (optional) --------------------------------------------
# Set the bucket AND all three credentials, or none of them. A partial set is
# rejected at startup rather than failing on first upload.
STORAGE_PROVIDER=r2
STORAGE_BUCKET_NAME=
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_DOMAIN=
STORAGE_USE_PUBLIC_URL=false
